{
  "name": "accessManager",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "",
  "main": "index.cjs",
  "scripts": {
    "build": "tsc",
    "setup:local": "node deploy/localDev/localSetting.mjs",
    "prestart": "pnpm run build",
    "start": "func start",
    "deploy": "pnpm deploy --filter accessManager --prod out",
    "test:vitest": "cross-env vitest run vitest/testQuestion.test.mjs",
    "test:vitest:debug": "cross-env NODE_OPTIONS=--inspect-brk=9230 vitest run vitest/testQuestion.test.mjs --pool=forks --no-file-parallelism",
    "test:profile": "vitest --root ../../.. run module/accessManager/func/vitest/profile.test.mjs --pool=forks --no-file-parallelism",
    "test:profile-db": "vitest --root ../../.. run module/accessManager/func/vitest/profile.test.mjs module/accessManager/func/vitest/dbTest.test.mjs --pool=forks --no-file-parallelism"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.4.1",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.31",
    "@azure/service-bus": "^7.9.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-http": "^0.202.0",
    "@opentelemetry/instrumentation-pg": "^0.54.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.32.0",
    "applicationinsights": "^3.6.0",
    "archiver": "^7.0.1",
    "fast-json-patch": "^3.1.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "postgrejs": "^2.15.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.17.14",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "azure-functions-core-tools": "^4.x",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "env-cmd": "^10.1.0",
    "jest": "^29.7.0",
    "minimist": "^1.2.8",
    "typescript": "^6.0.3",
    "umzug": "^3.8.2",
    "vitest": "^4.1.9"
  }
}