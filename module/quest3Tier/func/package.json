{
  "name": "quest3Tier",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "",
  "main": "dist/index.cjs",
  "scripts": {
    "start": "func start",
    "deploy": "pnpm deploy --filter quest3Tier --prod out",
    "build": "node -e \"require('node:fs').rmSync(require('node:path').join('dist', 'deploy', 'db', 'migration'), { recursive: true, force: true })\" && tsc --project tsconfig.json && tsc --project tsconfig.deploy.json --outDir dist",
    "build:deploy-db": "node -e \"require('node:fs').rmSync(require('node:path').join('dist', 'migrate'), { recursive: true, force: true })\" && tsc --project tsconfig.deploy.json",
    "dbmigrate:local": "pnpm i && pnpm run build:deploy-db && node dist/migrate/deploy/db/updateDbSchemaLocal.mjs",
    "watch": "tsc --project tsconfig.json --watch",
    "prestart": "pnpm run build",
    "test:vitest": "cross-env vitest run vitest/testQuestion.test.mts",
    "test:vitest:debug": "cross-env NODE_OPTIONS=--inspect-brk=9230 vitest run vitest/testQuestion.test.mts --pool=forks --no-file-parallelism",
    "test:profile": "vitest --root ../../.. run module/quest3Tier/func/vitest/profile.test.mts --pool=forks --no-file-parallelism",
    "test:profile-db": "vitest --root ../../.. run module/quest3Tier/func/vitest/profile.test.mts module/quest3Tier/func/vitest/dbTest.test.mts --pool=forks --no-file-parallelism"
  },
  "dependencies": {
    "@apvee/azure-functions-openapi": "2.0.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.4.1",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.31",
    "@azure/service-bus": "^7.9.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-http": "^0.202.0",
    "@opentelemetry/instrumentation-pg": "^0.54.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.32.0",
    "@sequelize/core": "^7.0.0-alpha.47",
    "@sequelize/postgres": "^7.0.0-alpha.47",
    "applicationinsights": "^3.6.0",
    "archiver": "^7.0.1",
    "fast-json-patch": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "postgrejs": "^2.15.4",
    "swagger-ui-dist": "^5.17.14",
    "uuid": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.x",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "env-cmd": "^10.1.0",
    "minimist": "^1.2.8",
    "umzug": "^3.8.2",
    "vitest": "^4.1.9",
    "openvino-genai-node": "^2026.4.1"
  }
}