{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZenMe-AU/ZBReactArchitecture/main/module/QFF/QFFLineage/schemas/1-0-0/LineageJobFacet.json",
  "title": "LineageJobFacet",
  "description": "Actions, operation type and optional field mappings for a declared job, not a record of execution.",
  "allOf": [{ "$ref": "https://openlineage.io/spec/2-0-2/OpenLineage.json#/$defs/JobFacet" }],
  "type": "object",
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "operation": { "enum": ["query", "command"] },
    "queryParameters": {
      "description": "Names of query selectors, not dataset dependencies.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "mapping": { "$ref": "LineageDatasetFacet.json#/properties/mapping" },
    "resolveIdentity": { "$ref": "LineageDatasetFacet.json#/properties/resolveIdentity" },
    "kindByGroup": { "$ref": "LineageDatasetFacet.json#/properties/kindByGroup" }
  },
  "dependentRequired": { "resolveIdentity": ["mapping"], "kindByGroup": ["mapping"] },
  "dependentSchemas": {
    "queryParameters": { "required": ["operation"], "properties": { "operation": { "const": "query" } } }
  },
  "if": { "required": ["mapping"], "properties": { "mapping": { "const": "flatten-by-kind" } } },
  "then": { "required": ["kindByGroup"] }
}
